#!/bin/bash
"$(portageq get_repo_path / pentoo)"/scripts/binpkgs-missing | python3 -c '
import sys
import portage
from portage._sets.base import WildcardPackageSet
root = portage.settings["ROOT"]
portdb = portage.db[root]["porttree"].dbapi
vardb = portage.db[root]["vartree"].dbapi
# matched like emerge --usepkg-exclude, which gets the same list from the profile
restricted = WildcardPackageSet(portage.settings.get("PENTOO_BINPKG_RESTRICTED", "").split())
for line in sys.stdin:
    cpv = line.strip().lstrip("=")
    # a binpkg of a version no longer in the tree is only deleted again by eclean-pkg
    if not portdb.cpv_exists(cpv):
        continue
    if restricted.findAtomForPackage(vardb._pkg_str(cpv, None)):
        continue
    sys.stdout.write(line)
'
