FROM pentoolinux/pentoo-core-ci

# Setup repos
WORKDIR /var/db/repos/
# setup gentoo repo
RUN git clone https://github.com/gentoo/gentoo.git --depth 1
# setup pentoo repo
#RUN git clone https://github.com/pentoo/pentoo-overlay.git pentoo --depth 1
# Use the github checkout for pentoo, that's what we are testing
COPY . pentoo

#Regen doubles the time it takes for the action to run
#Revisit if this is worth running when we have >2 emerge calls
#RUN time FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" emerge --regen --jobs=$(nproc) --quiet

WORKDIR /home

# Check consistency of all metadata in the repo
RUN time FEATURES="-getbinpkg -ipc-sandbox -network-sandbox -pid-sandbox" emerge --regen --jobs="$(nproc)" --quiet
# test install pentoo/pentoo
# An update whose dependencies are masked is only a warning, since the
# installed version is kept, but a stage built from scratch fails on it.
# Updates held back by a version conflict are left to the gentoo tree.
RUN time FEATURES="-getbinpkg -ipc-sandbox -network-sandbox -pid-sandbox" emerge --getbinpkg=n --buildpkg=n --jobs=$(nproc) --load-average=$(nproc) --deep --update --newuse pentoo/pentoo --verbose --pretend > /tmp/emerge.out 2>&1; \
  rc=$?; \
  cat /tmp/emerge.out; \
  if grep -q "skipped due to unsatisfied dependencies" /tmp/emerge.out; then \
    echo "FAIL: emerge skipped updates with masked dependencies, see the unsatisfied dependencies above"; \
    exit 1; \
  fi; \
  exit "${rc}"
