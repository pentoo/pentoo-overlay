#!/bin/bash
set -x
WARNED='0'
FAILED='0'
FEATURES='-ipc-sandbox -network-sandbox -pid-sandbox'
export FEATURES
# In CI HEAD is the PR's merge commit, so HEAD^1 is the master it was merged into
BASE="${TEST_BUILD_BASE:-HEAD^1}"
TESTING_KEYWORDS='amd64 ~amd64'
EXPLAIN="$(dirname "$0")/explain-failure"
SUMMARY=''
[ -d '/etc/portage/env' ] || mkdir -p /etc/portage/env/
printf 'FEATURES="%s test"\n' "${FEATURES}" >> /etc/portage/env/features-test

pretend_build() {
  emerge --getbinpkg=y --buildpkg=n --jobs="$(nproc)" --load-average="$(nproc)" --verbose --pretend "${1}"
}

dep_build() {
  emerge --getbinpkg=y --buildpkg=n --jobs="$(nproc)" --load-average="$(nproc)" --verbose --onlydeps "${1}"
}

# $1: atom, $2: its category/package, which never comes from a binpkg
binpkg_build() {
  emerge --getbinpkg=y --buildpkg=n --usepkg-exclude "${2}" --jobs="$(nproc)" --load-average="$(nproc)" --verbose "${1}"
}

build() {
  FEATURES="${FEATURES} -getbinpkg" emerge --getbinpkg=n --buildpkg=n --jobs="$(nproc)" --load-average="$(nproc)" --verbose "${1}"
}

print_build_log() {
  local log
  log=$(find /var/tmp/portage -name 'build.log' 2>/dev/null | head -1)
  if [ -n "${log}" ]; then
    printf '=== build.log: %s ===\n' "${log}"
    cat "${log}"
    printf '=== end build.log ===\n'
  fi
}

# $1: result, $2: ebuild, $3: optional reason
note() {
  SUMMARY="${SUMMARY}$(printf '%-24s %s%s' "${1}" "${2}" "${3:+ ${3}}")"$'\n'
}

# Until we have a pentoo-ci to build from, add in the bdeps in the first step to avoid circular breakage
#emerge --with-bdeps=y --jobs="$(nproc)" --load-average="$(nproc)" --verbose @world

EBUILDS=''
for i in $(git --no-pager diff --name-only --diff-filter=d "${BASE}" HEAD); do
  [ "${i%.ebuild}" != "${i}" ] || continue
  EBUILDS="${EBUILDS} ${i}"
done
# The image's package.env may not end in a newline
if [ -s /etc/portage/package.env ] && [ -n "$(tail -c 1 /etc/portage/package.env)" ]; then
  printf '\n' >> /etc/portage/package.env
fi
for i in ${EBUILDS}; do
  printf '%s features-test\n' "$(printf '%s' "${i%.ebuild}" | awk -F'/' '{print "="$1"/"$3"::pentoo"}')" >> /etc/portage/package.env
done

for i in ${EBUILDS}; do
  test_ebuild="$(printf '%s' "${i%.ebuild}" | awk -F'/' '{print "="$1"/"$3"::pentoo"}')"
  test_package="$(printf '%s' "${i}" | awk -F'/' '{print $1"/"$2}')"
  printf '%s looks like an ebuild, testing visibility\n' "${i}"
  if grep -q 'linux-mod-r1' "${i}"; then
    printf '%s inherits a kernel module eclass, skipping build (no configured kernel in CI)\n' "${i}"
    note 'skipped (kernel module)' "${i}"
    continue
  fi
  unset ACCEPT_KEYWORDS
  if [ -n "$(portageq best_visible / "${test_ebuild}")" ]; then
    testing=''
  elif [ -n "$(ACCEPT_KEYWORDS="${TESTING_KEYWORDS}" portageq best_visible / "${test_ebuild}")" ]; then
    testing='1'
    printf 'WARNING: %s is only keyworded ~amd64, users have to accept it to install it.  Testing it with ACCEPT_KEYWORDS="%s"\n' "${i}" "${TESTING_KEYWORDS}"
    WARNED='1'
    export ACCEPT_KEYWORDS="${TESTING_KEYWORDS}"
  else
    printf '%s is masked by more than a keyword, skipping build test\n' "${i}"
    note 'skipped (masked)' "${i}"
    continue
  fi
  pretend_build "${test_ebuild}" > /tmp/pretend.out 2>&1
  pretend_rc=$?
  cat /tmp/pretend.out
  if [ "${pretend_rc}" != 0 ]; then
    reason="$("${EXPLAIN}" emerge /tmp/pretend.out)"
    if [ -n "${testing}" ]; then
      printf 'WARNING: %s cannot be installed even on ~amd64, see the emerge output above\n' "${i}"
      note 'WARNING (~amd64 deps)' "${i}" "${reason}"
    else
      printf '%s is visible but cannot be installed, see the emerge output above\n' "${i}"
      note 'FAILED (deps)' "${i}" "${reason}"
      FAILED='1'
    fi
    continue
  fi
  printf '%s appears to be unmasked, building deps\n' "${i}"
  if dep_build "${test_ebuild}"; then
    printf '%s deps have built, build testing\n' "${i}"
    if binpkg_build "${test_ebuild}" "${test_package}"; then
      printf '%s binpkg build SUCCESS\n' "${i}"
      note "built${testing:+ (~amd64)}" "${i}"
    else
      printf '%s binpkg build FAILED\n' "${i}"
      print_build_log
      if build "${test_ebuild}"; then
        printf '%s build without binpkgs SUCCESS\n' "${i}"
        note "built${testing:+ (~amd64)}" "${i}"
      else
        printf '%s build without binpkgs also FAILED\n' "${i}"
        print_build_log
        note 'FAILED (build)' "${i}"
        FAILED="1"
      fi
    fi
  else
    printf 'WARNING WARNING WARNING\n'
    printf '%s deps failed to build.  This is a bad sign which we are ignoring for now\n' "${i}"
    printf 'WARNING WARNING WARNING\n'
    note 'WARNING (dep build)' "${i}"
    WARNED='1'
  fi
done
unset ACCEPT_KEYWORDS
set +x
printf '=== build test summary ===\n%s=== end summary ===\n' "${SUMMARY:-no ebuilds changed
}"
if [ "${WARNED}" = '1' ]; then
  printf 'WARNING WARNING WARNING\n'
  printf 'There were warnings during this build which may be fatal later.  Please review the logs.\n'
  printf 'WARNING WARNING WARNING\n'
else
  printf 'No warnings generated by this script.\n'
fi
if [ "${FAILED}" = '0' ]; then
  printf 'No failures seen by this script.\n'
else
  printf 'FAILED FAILED FAILED\n'
  printf 'Something above failed, please review the output.\n'
  printf 'FAILED FAILED FAILED\n'
fi
exit "${FAILED}"
