src_prepare() {
	# https://github.com/chroma-core/chroma/issues/6687
	sed -i -e '1i #![recursion_limit = "256"]' rust/segment/src/lib.rs
	# https://github.com/chroma-core/chroma/issues/6891
	sed -i -e '1i #![recursion_limit = "256"]' rust/blockstore/src/lib.rs
	# https://github.com/chroma-core/chroma/issues/6892
	sed -i -e '1i #![recursion_limit = "256"]' rust/index/src/lib.rs

	# we only need the zip file for the crate utoipa-swagger-ui
	rm -r "${WORKDIR}"/swagger-ui-5.32.6
	eapply_user
}

python_compile() {
	SWAGGER_UI_DOWNLOAD_URL="file://${DISTDIR}/swagger-ui.zip" distutils-r1_python_compile
}
