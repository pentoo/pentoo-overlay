#!/bin/sh
# postsync.d hook: after a sync, trust the Pentoo binhost key the way the
# freshly synced pentoo repo has it.  A failing hook would make the whole sync
# look failed, so this only warns.
repo=$(portageq get_repo_path / pentoo 2> /dev/null)
helper=${repo}/pentoo/pentoo-core/files/pentoo-trust-helper
if [ -n "${repo}" ] && [ -f "${helper}" ]; then
	set -- bash "${helper}"
elif command -v pentoo-trust-helper > /dev/null 2>&1; then
	set -- pentoo-trust-helper
else
	exit 0
fi
if ! out=$("$@" 2>&1); then
	printf '%s\n' "${out}" >&2
	printf 'pentoo-trust-helper failed, binpkgs from the Pentoo binhost may be rejected\n' >&2
fi
exit 0
