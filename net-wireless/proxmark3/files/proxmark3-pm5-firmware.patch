+
+if [ "${BUILD}" != "pm3-only" ]; then
+  # PM5
+
+  make "$@" PLATFORM=PM5 PLATFORM_EXTRAS= STANDALONE= fullimage || exit 1
+  chmod 644 armsrc/obj/fullimage.elf
