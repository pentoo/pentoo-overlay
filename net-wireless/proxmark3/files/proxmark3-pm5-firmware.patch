+  ${STATS} && ( echo "   text	   data	    bss	    dec	    hex	filename" >> standalones_stats.txt )
+  for mode in "${STANDALONE_MODES[@]}"; do
+    # *** Chosen Standalone mode * requires -DWITH_FPC_USART_HOST, unsupported by Proxmark5.  Stop.
