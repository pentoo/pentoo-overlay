 # These vars can be overridden by env variables
-echo "Makefile flags: ${MKFLAGS:=-j8}"
+echo "Makefile flags: ${MKFLAGS:=-j$(nproc)}"
 echo "Destination:    ${DEST:=firmware}"
 echo "Produce stats?: ${STATS:=false}"
 
+if [ "${1}" = "--pm5-only" ]; then
+  BUILD="pm5-only"
+elif [ "${1}" = "--pm3-only" ]; then
+  BUILD="pm3-only"
+fi
+
+# This safely splits MKFLAGS into arguements and stores in $@
+# This prevents anything in here from accidently becoming a shell glob and doing unexpected things
+set -f
+# shellcheck disable=SC2086
+set -- ${MKFLAGS}
+set +f
+
 # Which parts to skip for the 256kb version?
 SKIPS256="SKIP_HITAG=1 SKIP_LEGICRF=1 SKIP_FELICA=1 SKIP_EM4x50=1 SKIP_EM4x70=1 SKIP_ISO14443b=1 SKIP_NFCBARCODE=1 SKIP_ZX8211=1 SKIP_LF=1 SKIP_DESFIRE_SIM=1"
 
-make $MKFLAGS bootrom || exit 1
+make "$@" bootrom || exit 1
 chmod 644 bootrom/obj/bootrom.elf
 mkdir -p "$DEST"
 mv bootrom/obj/bootrom.elf "$DEST/PM3BOOTROM.elf"
@@ -41,52 +54,89 @@ STANDALONE_MODES_REQ_FLASH=(LF_HIDFCBRUTE LF_ICEHID LF_NEXID LF_THAREXDE HF_BOG
 # PM3GENERIC 256kb, no flash, need to skip some parts to reduce size
 
